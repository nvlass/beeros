;; beer.fs — mount table and path-level file access (see docs/filesystem.md)
;;
;; Paths are absolute. The longest mount point that prefixes a path picks
;; the filesystem; the rest of the path goes to that filesystem's ops.
;; At boot the first ext2 block device is mounted at "/" and beer.core's
;; file functions (slurp, load-file, require from /lib) are pointed at
;; beer.fs; /etc/init.beer runs once all libraries are loaded.

(ns beer.fs)

(def impls
  {:ext2 {:ls         beer.ext2/ls
          :slurp      beer.ext2/slurp
          :read-bytes beer.ext2/read-bytes
          :stat       beer.ext2/stat
          :lstat      beer.ext2/lstat
          :readlink   beer.ext2/readlink}})

(def mount-table (atom {}))

(defn normalize-mount-point [p]
  (if (and (not= p "/") (beer.string/ends-with? p "/"))
    (subs p 0 (dec (count p)))
    p))

(defn mount! [point fs]
  (when (nil? (get impls (:type fs)))
    (throw (ex-info (str "fs: no ops for filesystem type " (:type fs)) {:fs (:name fs)})))
  (swap! mount-table assoc (normalize-mount-point point) fs)
  point)

(defn umount! [point]
  (swap! mount-table dissoc (normalize-mount-point point))
  nil)

(defn mounts []
  (let [m @mount-table]
    (into {} (map (fn [p] (let [fs (get m p)] [p (str (:name fs) " (" (name (:type fs)) ")")]))
                  (keys m)))))

(defn under? [point path]
  (or (= point "/")
      (= path point)
      (beer.string/starts-with? path (str point "/"))))

(defn locate
  "[fs rest-of-path] for an absolute path."
  [path]
  (when (not (beer.string/starts-with? path "/"))
    (throw (ex-info (str "fs: path must be absolute: " path) {:path path :reason :relative-path})))
  (let [point (reduce (fn [best p]
                        (if (and (under? p path) (or (nil? best) (> (count p) (count best)))) p best))
                      nil (keys @mount-table))]
    (when (nil? point)
      (throw (ex-info (str "fs: nothing mounted for " path) {:path path :reason :not-mounted})))
    [(get @mount-table point)
     (if (= point "/") path (let [r (subs path (count point))] (if (= r "") "/" r)))]))

(defn op [k path]
  (let [[fs rel] (locate path)]
    ((get (get impls (:type fs)) k) fs rel)))

;; ── paths inside tar files ────────────────────────────────────────────────
;; A tar file reads like a directory: /pkg/hello.tar/hello/core.beer is the
;; entry hello/core.beer of /pkg/hello.tar (packages, docs/packages.md).
;; Read-only; an archive is read once and kept until its inode changes.

(def tar-cache (atom {}))   ; tar path -> {:key :bytes :index}

(defn tar-file? [path]
  (and (beer.string/ends-with? path ".tar")
       (= :file (try (:type (op :stat path)) (catch e nil)))))

(defn split-tar
  "[tar-path inner] when path goes through a tar file (inner \"\" is the
  archive's top), else nil."
  [path]
  (let [parts (beer.string/split path "/")]
    (loop [i 1 prefix ""]
      (when (< i (count parts))
        (let [prefix (str prefix "/" (nth parts i))]
          (if (and (< (inc i) (count parts)) (tar-file? prefix))
            [prefix (beer.string/join "/" (filter (fn [x] (not= x "")) (drop (inc i) parts)))]
            (if (and (= (inc i) (count parts)) (beer.string/ends-with? path ".tar/") (tar-file? prefix))
              [prefix ""]
              (recur (inc i) prefix))))))))

(defn tar-open [tp]
  (let [st (op :stat tp)
        k  [(:ino st) (:mtime st) (:size st)]
        c  (get @tar-cache tp)]
    (if (and c (= (:key c) k))
      c
      (let [b (op :read-bytes tp)
            t {:key k :bytes b :index (beer.ustar/index b)}]
        (swap! tar-cache assoc tp t)
        t))))

(defn tar-fail! [opk path reason]
  (throw (ex-info (str "fs: " path ": " (name reason)) {:op opk :path path :reason reason})))

(defn tar-dir? [index inner]
  (or (= inner "")
      (= :dir (:type (get index inner)))
      (some (fn [n] (beer.string/starts-with? n (str inner "/"))) (keys index))))

(defn tar-op [k path tp inner]
  (let [t (tar-open tp) index (:index t) e (get index inner)]
    (cond
      (or (= k :stat) (= k :lstat))
      (cond (and e (not= (:type e) :dir)) {:type (:type e) :size (:size e) :tar tp}
            (tar-dir? index inner)      {:type :dir :size 0 :tar tp}
            :else (tar-fail! k path :not-found))
      (= k :ls)
      (if (tar-dir? index inner)
        (let [pre (if (= inner "") "" (str inner "/"))]
          (sort (distinct (map (fn [n] (first (beer.string/split (subs n (count pre)) "/")))
                               (filter (fn [n] (and (beer.string/starts-with? n pre) (not= n pre)))
                                       (keys index))))))
        (tar-fail! k path :not-a-directory))
      (nil? e) (tar-fail! k path :not-found)
      (= (:type e) :dir) (tar-fail! k path :is-a-directory)
      (= k :read-bytes) (beer.ustar/entry-bytes (:bytes t) e)
      (= k :slurp) (or (beer.ustar/entry-string (:bytes t) e) (tar-fail! k path :not-utf8))
      :else (tar-fail! k path :not-supported))))

(defn path-op [k path]
  (let [st (when (beer.string/includes? path ".tar/") (split-tar path))]
    (if st (tar-op k path (first st) (second st)) (op k path))))

(defn ls         [path] (path-op :ls path))
(defn slurp      [path] (path-op :slurp path))
(defn read-bytes [path] (path-op :read-bytes path))
(defn stat       [path] (path-op :stat path))
(defn lstat      [path] (path-op :lstat path))
(defn readlink   [path] (op :readlink path))

(defn exists? [path]
  (try (stat path) true (catch e false)))

;; ── beerlang's file system hook ──────────────────────────────────────────
;; slurp, spit, load-file and require's *load-path* search in beer.core go
;; through beer.core/*fs*, so they work on these paths unchanged.

(defn hook-read [path]
  (try (slurp path) (catch e nil)))

(defn hook-write! [path s append?]
  (throw (ex-info (str "fs: " path ": file systems are read-only so far")
                  {:path path :reason :read-only})))

(def beer.core/*fs* {:read hook-read :write! hook-write!})
(def beer.core/*load-path* ["/lib/"])

;; ── boot: mount the first ext2 device at /, run /etc/init.beer ───────────

(defn auto-mount! []
  (let [found (some (fn [dname]
                      (try [dname (beer.ext2/mount (beer.blk/device dname))]
                           (catch e nil)))
                    (sort (beer.blk/devices)))]
    (when found
      (mount! "/" (second found))
      (println (str "[beeros] mounted " (first found) " (ext2) at /")))))

(def init-file "/etc/init.beer")

(defn run-init! []
  (when (and (not (empty? @mount-table)) (exists? init-file))
    (try
      (load-file init-file)
      (catch e (println (str "[beeros] " (:message e)))))))

(auto-mount!)
