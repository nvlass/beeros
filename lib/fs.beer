;; beer.fs — mount table and path-level file access (see docs/filesystem.md)
;;
;; Paths are absolute. The longest mount point that prefixes a path picks
;; the filesystem; the rest of the path goes to that filesystem's ops.
;; At boot the first ext2 block device is mounted at "/", `require` learns
;; to load namespaces from load-path (/lib), and /etc/init.beer runs.

(ns beer.fs)

(def impls
  {:ext2 {:ls         beer.ext2/ls
          :slurp      beer.ext2/slurp
          :read-bytes beer.ext2/read-bytes
          :stat       beer.ext2/stat
          :lstat      beer.ext2/lstat
          :readlink   beer.ext2/readlink}})

(def mount-table (atom {}))

(defn normalize-mount-point [p]
  (if (and (not= p "/") (beer.string/ends-with? p "/"))
    (subs p 0 (dec (count p)))
    p))

(defn mount! [point fs]
  (when (nil? (get impls (:type fs)))
    (throw (ex-info (str "fs: no ops for filesystem type " (:type fs)) {:fs (:name fs)})))
  (swap! mount-table assoc (normalize-mount-point point) fs)
  point)

(defn umount! [point]
  (swap! mount-table dissoc (normalize-mount-point point))
  nil)

(defn mounts []
  (let [m @mount-table]
    (into {} (map (fn [p] (let [fs (get m p)] [p (str (:name fs) " (" (name (:type fs)) ")")]))
                  (keys m)))))

(defn under? [point path]
  (or (= point "/")
      (= path point)
      (beer.string/starts-with? path (str point "/"))))

(defn locate
  "[fs rest-of-path] for an absolute path."
  [path]
  (when (not (beer.string/starts-with? path "/"))
    (throw (ex-info (str "fs: path must be absolute: " path) {:path path :reason :relative-path})))
  (let [point (reduce (fn [best p]
                        (if (and (under? p path) (or (nil? best) (> (count p) (count best)))) p best))
                      nil (keys @mount-table))]
    (when (nil? point)
      (throw (ex-info (str "fs: nothing mounted for " path) {:path path :reason :not-mounted})))
    [(get @mount-table point)
     (if (= point "/") path (let [r (subs path (count point))] (if (= r "") "/" r)))]))

(defn op [k path]
  (let [[fs rel] (locate path)]
    ((get (get impls (:type fs)) k) fs rel)))

(defn ls         [path] (op :ls path))
(defn slurp      [path] (op :slurp path))
(defn read-bytes [path] (op :read-bytes path))
(defn stat       [path] (op :stat path))
(defn lstat      [path] (op :lstat path))
(defn readlink   [path] (op :readlink path))

(defn exists? [path]
  (try (stat path) true (catch e false)))

(defn load-file
  "Read and evaluate every form in the file at path, in order; returns the
  last value. The current namespace is restored afterwards."
  [path]
  (let [forms (read-string (str "[" (slurp path) "\n]"))
        saved *ns*]
    (try
      (loop [fs forms i 0 result nil]
        (if (empty? fs)
          result
          (let [r (try (eval (first fs))
                       (catch e
                         (throw (ex-info (str path ", form " i ": " (:message e))
                                         {:path path :form i :cause e}))))]
            (recur (rest fs) (inc i) r))))
      (finally (in-ns saved)))))

;; ── require from the filesystem ───────────────────────────────────────────
;; beerlang's require only fopen()s host paths (and an in-memory tar index).
;; It skips loading a namespace already in beer.core/*loaded-libs* but
;; still applies :as / :refer, so this wrapper loads foo.bar from
;; <dir>/foo/bar.beer, marks it loaded and hands over. Remove it once
;; beerlang has a source-lookup hook (beerlang TODO.md, beeros request).

(def load-path (atom ["/lib"]))

(def native-require
  (or (try beer.fs/native-require (catch e nil))   ; reloading fs.beer keeps the original
      beer.core/require))

(defn ns->rel-path [ns-sym]
  (str (beer.string/replace (name ns-sym) "." "/") ".beer"))

(defn find-source
  "Path of the file defining ns-sym on load-path, or nil."
  [ns-sym]
  (let [rel (ns->rel-path ns-sym)]
    (some (fn [dir]
            (let [p (str dir "/" rel)]
              (when (exists? p) p)))
          (if (empty? @mount-table) [] @load-path))))

(defn loaded-libs [] (try beer.core/*loaded-libs* (catch e nil)))

(defn loaded? [ns-sym]
  (let [m (loaded-libs)] (and m (get m (keyword (name ns-sym))))))

(def loading (atom #{}))

(defn require-one [ns-sym opts]
  (when (not (loaded? ns-sym))
    (let [path (find-source ns-sym)]
      (when path
        (when (contains? @loading ns-sym)
          (throw (ex-info (str "require: circular dependency on " ns-sym)
                          {:ns ns-sym :reason :circular})))
        (swap! loading conj ns-sym)
        (try
          (load-file path)
          (finally (swap! loading disj ns-sym)))
        (def beer.core/*loaded-libs*
          (assoc (or (loaded-libs) (hash-map)) (keyword (name ns-sym)) true)))))
  (apply native-require ns-sym opts))

(defn require
  "Like beer.core/require, but finds namespaces on load-path first. Also
  takes Clojure's vector form: (require '[foo.bar :as fb] 'baz)."
  [x & more]
  (if (vector? x)
    (do (require-one (first x) (rest x))
        (doseq [y more] (require y))
        nil)
    (if (and (not (empty? more)) (keyword? (first more)))
      (require-one x more)                       ; (require 'ns :as 'a ...)
      (do (require-one x [])
          (doseq [y more] (require y))
          nil))))

(def beer.core/require require)

;; ── boot: mount the first ext2 device at /, run /etc/init.beer ───────────

(defn auto-mount! []
  (let [found (some (fn [dname]
                      (try [dname (beer.ext2/mount (beer.blk/device dname))]
                           (catch e nil)))
                    (sort (beer.blk/devices)))]
    (when found
      (mount! "/" (second found))
      (println (str "[beeros] mounted " (first found) " (ext2) at /")))))

(def init-file "/etc/init.beer")

(defn run-init! []
  (when (and (not (empty? @mount-table)) (exists? init-file))
    (try
      (load-file init-file)
      (catch e (println (str "[beeros] " init-file ": " (:message e)))))))

(auto-mount!)
