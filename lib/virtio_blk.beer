;; beer.virtio-blk — virtio-blk driver in beerlang
;;
;; One split virtqueue, one request in flight, polled completion. Same job
;; as kernel/virtio_blk.c, written on beer.virtio (transport + queues) and
;; beer.bytes, and it builds the same block-device map, so everything above
;; (beer.blk, filesystems) can't tell the two apart.
;;
;; One driver owns a device at a time: whichever one initialises it resets
;; the device and points it at its own rings. Switch at the REPL with
;; (beer.virtio-blk/attach!) and (beer.blk/use-native-driver!).

(ns beer.virtio-blk)

(def device-block 2)

(def f-blk-ro    (bit-shift-left 1 5))
(def f-blk-flush (bit-shift-left 1 9))

(def req-in    0)
(def req-out   1)
(def req-flush 4)

(def sector     512)
(def qsize      8)
(def timeout-ns 2000000000)

;; driver memory after the rings (beer.virtio/setup-queue! `extra`)
(def x-hdr    0)     ; request: type u32, reserved u32, sector u64
(def x-status 16)    ; request status, written by the device
(def x-size   32)

(defn capacity
  "Size in 512-byte sectors: a u64 read as two u32s, retried if the
  device changed its config in between."
  [base]
  (loop []
    (let [gen (beer.virtio/rd base beer.virtio/r-config-gen)
          lo  (beer.virtio/cfg32 base 0)
          hi  (beer.virtio/cfg32 base 4)]
      (if (= gen (beer.virtio/rd base beer.virtio/r-config-gen))
        (+ (bit-shift-left hi 32) lo)
        (recur)))))

(defn init
  "Reset the device at base, negotiate features, set up queue 0. Returns
  the driver's state map for it."
  [base]
  (let [f0 (beer.virtio/negotiate! base (bit-or f-blk-ro f-blk-flush))
        q  (beer.virtio/setup-queue! base 0 qsize x-size)]
    (beer.virtio/driver-ok! base)
    {:base       base
     :q          q
     :sectors    (capacity base)
     :read-only? (not= 0 (bit-and f0 f-blk-ro))
     :can-flush? (not= 0 (bit-and f0 f-blk-flush))}))

;; ── requests ──────────────────────────────────────────────────────────────

(defn submit!
  "Run descriptor chain 0 and spin until the device completes it. nil on
  success, or an error keyword."
  [d]
  (let [q (:q d)
        b (:ring q)]
    (beer.bytes/u8! b (beer.virtio/extra-off q x-status) 0xff)
    (beer.virtio/publish! q [0])
    (let [deadline (+ (nano-time) timeout-ns)]
      (loop []
        (if (nil? (beer.virtio/take-used! q))
          (if (> (nano-time) deadline) :timeout (recur))
          (let [s (beer.bytes/u8 b (beer.virtio/extra-off q x-status))]
            (cond (= s 0) nil
                  (= s 2) :unsupported
                  :else   :io-error)))))))

(defn set-header! [d type lba]
  (let [q (:q d)
        b (:ring q)
        h (beer.virtio/extra-off q x-hdr)]
    (beer.bytes/u32le! b h type)
    (beer.bytes/u32le! b (+ h 4) 0)
    (beer.bytes/u64le! b (+ h 8) lba)))

(defn rw!
  "Transfer n sectors between lba and buf (from byte off). nil or an
  error keyword, same as the C driver's natives."
  [d write? lba n buf off]
  (cond
    (or (< n 1) (< lba 0) (> (+ lba n) (:sectors d))) :out-of-range
    (and write? (:read-only? d))                     :read-only
    (> (+ off (* n sector)) (beer.bytes/capacity buf)) :buffer-too-small
    :else
    (let [q (:q d)]
      (set-header! d (if write? req-out req-in) lba)
      (beer.virtio/set-desc! q 0 (beer.virtio/extra-addr q x-hdr) 16 beer.virtio/desc-next 1)
      (beer.virtio/set-desc! q 1 (+ (beer.bytes/addr buf) off) (* n sector)
                             (if write?
                               beer.virtio/desc-next
                               (bit-or beer.virtio/desc-next beer.virtio/desc-write))
                             2)
      (beer.virtio/set-desc! q 2 (beer.virtio/extra-addr q x-status) 1 beer.virtio/desc-write 0)
      (submit! d))))

(defn flush-cache! [d]
  (if (:can-flush? d)
    (let [q (:q d)]
      (set-header! d req-flush 0)
      (beer.virtio/set-desc! q 0 (beer.virtio/extra-addr q x-hdr) 16 beer.virtio/desc-next 1)
      (beer.virtio/set-desc! q 1 (beer.virtio/extra-addr q x-status) 1 beer.virtio/desc-write 0)
      (submit! d))
    :unsupported))

;; ── block-device maps ─────────────────────────────────────────────────────

(defn device-map [id d]
  (let [nm  (str "virtio" id)
        chk (fn [op lba n result] (beer.blk/check nm op lba n result))]
    {:name        nm
     :driver      :virtio-beerlang
     :sector-size sector
     :sectors     (:sectors d)
     :read-only?  (:read-only? d)
     :read!       (fn [lba n buf off] (chk :read lba n (rw! d false lba n buf off)))
     :write!      (fn [lba n buf off] (chk :write lba n (rw! d true lba n buf off)))
     :flush!      (when (:can-flush? d)
                    (fn [] (chk :flush 0 0 (flush-cache! d))))
     :state       d}))

(defn attach!
  "Initialise every virtio-blk device with this driver and register them
  as virtio0, virtio1, ... in slot order (same names as the C driver).
  Takes devices away from whichever driver had them."
  []
  (let [bases (vec (beer.virtio/probe device-block))]
    (doseq [i (range (count bases))]
      (beer.blk/register-device! (device-map i (init (nth bases i)))))
    (beer.blk/devices)))

;; ── boot: which driver owns the devices ───────────────────────────────────
;; :beerlang (this file) or :native (kernel/virtio_blk.c).

(def boot-driver :beerlang)

(if (= boot-driver :beerlang)
  (attach!)
  (beer.blk/use-native-driver!))
