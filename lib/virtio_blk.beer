;; beer.virtio-blk — virtio-blk driver in beerlang
;;
;; virtio 1.x over virtio-mmio, one split virtqueue, one request in flight,
;; polled completion. Same job as kernel/virtio_blk.c, written on beer.mem
;; (MMIO registers) and beer.bytes (ring memory), and it builds the same
;; block-device map, so everything above (beer.blk, filesystems) can't tell
;; the two apart.
;;
;; One driver owns a device at a time: whichever one initialises it resets
;; the device and points it at its own rings. Switch at the REPL with
;; (beer.virtio-blk/attach!) and (beer.blk/use-native-driver!).

(ns beer.virtio-blk)

;; ── transport: QEMU virt (riscv) has 8 virtio-mmio slots ──────────────────

(def mmio-base   0x10001000)
(def mmio-stride 0x1000)
(def mmio-slots  8)

;; ── virtio-mmio registers (virtio 1.x §4.2.2) ─────────────────────────────

(def r-magic            0x000)
(def r-version          0x004)
(def r-device-id        0x008)
(def r-dev-features     0x010)
(def r-dev-features-sel 0x014)
(def r-drv-features     0x020)
(def r-drv-features-sel 0x024)
(def r-queue-sel        0x030)
(def r-queue-num-max    0x034)
(def r-queue-num        0x038)
(def r-queue-ready      0x044)
(def r-queue-notify     0x050)
(def r-int-status       0x060)
(def r-int-ack          0x064)
(def r-status           0x070)
(def r-queue-desc       0x080)   ; lo at +0, hi at +4
(def r-queue-avail      0x090)
(def r-queue-used       0x0a0)
(def r-config-gen       0x0fc)
(def r-config           0x100)   ; virtio_blk_config, u64 capacity first

(def virtio-magic 0x74726976)    ; "virt"
(def device-block 2)

(def st-acknowledge 1)
(def st-driver      2)
(def st-driver-ok   4)
(def st-features-ok 8)
(def st-failed      128)

(def f-blk-ro     (bit-shift-left 1 5))
(def f-blk-flush  (bit-shift-left 1 9))
(def f-version-1  1)             ; feature bit 32 = bit 0 of word 1

(def desc-next  1)
(def desc-write 2)               ; the device writes this buffer

(def req-in    0)
(def req-out   1)
(def req-flush 4)

(def sector     512)
(def qsize      8)
(def timeout-ns 2000000000)

(defn rd [base off] (beer.mem/read32 (+ base off)))
(defn wr! [base off v] (beer.mem/write32! (+ base off) v))
(defn wr-addr! [base off addr]
  (wr! base off (bit-and addr 0xFFFFFFFF))
  (wr! base (+ off 4) (bit-shift-right addr 32)))

;; ── ring memory ───────────────────────────────────────────────────────────
;; One ByteBuffer per device holds the queue, the request header and the
;; status byte. Offsets are from the 16-byte-aligned start of that area.

(def o-desc   0)     ; qsize × 16: addr u64, len u32, flags u16, next u16
(def o-avail  128)   ; flags u16, idx u16, ring[qsize] u16, used_event u16
(def o-used   152)   ; flags u16, idx u16, ring[qsize] {id u32, len u32}, avail_event
(def o-hdr    224)   ; request: type u32, reserved u32, sector u64
(def o-status 240)   ; request status, written by the device
(def area-size 256)

(defn alloc-aligned
  "[buf off]: a ByteBuffer with n usable bytes starting at byte off, which
  sits on an align boundary (align a power of two). ByteBuffer has no
  aligned constructor yet, so over-allocate and round the address up."
  [n align]
  (let [buf  (beer.bytes/alloc (+ n align))
        mask (dec align)
        off  (bit-and (- align (bit-and (beer.bytes/addr buf) mask)) mask)]
    [buf off]))

(defn ring-addr [d o] (+ (beer.bytes/addr (:ring d)) (:ro d) o))
(defn ring-u16  [d o] (beer.bytes/u16le (:ring d) (+ (:ro d) o)))
(defn ring-u16! [d o v] (beer.bytes/u16le! (:ring d) (+ (:ro d) o) v))

(defn set-desc! [d i addr len flags next]
  (let [b (:ring d)
        o (+ (:ro d) o-desc (* i 16))]
    (beer.bytes/u64le! b o addr)
    (beer.bytes/u32le! b (+ o 8) len)
    (beer.bytes/u16le! b (+ o 12) flags)
    (beer.bytes/u16le! b (+ o 14) next)))

;; ── device setup ──────────────────────────────────────────────────────────

(defn probe
  "Base addresses of the virtio-mmio slots holding a modern block device."
  []
  (filter (fn [base]
            (and (= (rd base r-magic) virtio-magic)
                 (= (rd base r-device-id) device-block)
                 (= (rd base r-version) 2)))
          (map (fn [slot] (+ mmio-base (* slot mmio-stride)))
               (range mmio-slots))))

(defn device-features [base sel]
  (wr! base r-dev-features-sel sel)
  (rd base r-dev-features))

(defn capacity
  "Size in 512-byte sectors: a u64 read as two u32s, retried if the
  device changed its config in between."
  [base]
  (loop []
    (let [gen (rd base r-config-gen)
          lo  (rd base r-config)
          hi  (rd base (+ r-config 4))]
      (if (= gen (rd base r-config-gen))
        (+ (bit-shift-left hi 32) lo)
        (recur)))))

(defn init-failed! [base status reason]
  (wr! base r-status (bit-or status st-failed))
  (throw (ex-info (str "virtio-blk init failed: " (name reason))
                  {:base base :reason reason})))

(defn init
  "Reset the device at base, negotiate features, set up queue 0 on fresh
  ring memory. Returns the driver's state map for it."
  [base]
  (wr! base r-status 0)
  (wr! base r-status (bit-or st-acknowledge st-driver))
  (let [f0     (device-features base 0)
        f1     (device-features base 1)
        want0  (bit-and f0 (bit-or f-blk-ro f-blk-flush))
        status (bit-or (bit-or st-acknowledge st-driver) st-features-ok)]
    (when (= 0 (bit-and f1 f-version-1))
      (init-failed! base status :no-version-1))
    (wr! base r-drv-features-sel 0)
    (wr! base r-drv-features want0)
    (wr! base r-drv-features-sel 1)
    (wr! base r-drv-features f-version-1)
    (wr! base r-status status)
    (when (= 0 (bit-and (rd base r-status) st-features-ok))
      (init-failed! base status :features-rejected))
    (wr! base r-queue-sel 0)
    (when (< (rd base r-queue-num-max) qsize)
      (init-failed! base status :queue-too-small))
    (let [[ring ro] (alloc-aligned area-size 16)
          d {:base       base
             :ring       ring
             :ro         ro
             :sectors    (capacity base)
             :read-only? (not= 0 (bit-and want0 f-blk-ro))
             :can-flush? (not= 0 (bit-and want0 f-blk-flush))
             :used-seen  (atom 0)}]
      (wr! base r-queue-num qsize)
      (wr-addr! base r-queue-desc  (ring-addr d o-desc))
      (wr-addr! base r-queue-avail (ring-addr d o-avail))
      (wr-addr! base r-queue-used  (ring-addr d o-used))
      (wr! base r-queue-ready 1)
      (wr! base r-status (bit-or status st-driver-ok))
      d)))

;; ── requests ──────────────────────────────────────────────────────────────

(defn submit!
  "Publish descriptor chain 0, notify the device, spin until it completes.
  nil on success, or an error keyword."
  [d]
  (let [b    (:ring d)
        base (:base d)
        idx  (ring-u16 d (+ o-avail 2))]
    (beer.bytes/u8! b (+ (:ro d) o-status) 0xff)
    (ring-u16! d (+ o-avail 4 (* 2 (bit-and idx (dec qsize)))) 0)
    (beer.mem/fence)                          ; descriptors before the index
    (ring-u16! d (+ o-avail 2) (bit-and (inc idx) 0xffff))
    (beer.mem/fence)                          ; index before the notify
    (wr! base r-queue-notify 0)
    (let [seen     @(:used-seen d)
          deadline (+ (nano-time) timeout-ns)]
      (loop []
        (if (= (ring-u16 d (+ o-used 2)) seen)
          (if (> (nano-time) deadline) :timeout (recur))
          (do
            (beer.mem/fence)                  ; used index before the data
            (reset! (:used-seen d) (bit-and (inc seen) 0xffff))
            (wr! base r-int-ack (rd base r-int-status))
            (let [s (beer.bytes/u8 b (+ (:ro d) o-status))]
              (cond (= s 0) nil
                    (= s 2) :unsupported
                    :else   :io-error))))))))

(defn set-header! [d type lba]
  (let [b (:ring d)
        h (+ (:ro d) o-hdr)]
    (beer.bytes/u32le! b h type)
    (beer.bytes/u32le! b (+ h 4) 0)
    (beer.bytes/u64le! b (+ h 8) lba)))

(defn rw!
  "Transfer n sectors between lba and buf (from byte off). nil or an
  error keyword, same as the C driver's natives."
  [d write? lba n buf off]
  (cond
    (or (< n 1) (< lba 0) (> (+ lba n) (:sectors d))) :out-of-range
    (and write? (:read-only? d))                     :read-only
    (> (+ off (* n sector)) (beer.bytes/capacity buf)) :buffer-too-small
    :else
    (do
      (set-header! d (if write? req-out req-in) lba)
      (set-desc! d 0 (ring-addr d o-hdr) 16 desc-next 1)
      (set-desc! d 1 (+ (beer.bytes/addr buf) off) (* n sector)
                 (if write? desc-next (bit-or desc-next desc-write)) 2)
      (set-desc! d 2 (ring-addr d o-status) 1 desc-write 0)
      (submit! d))))

(defn flush-cache! [d]
  (if (:can-flush? d)
    (do
      (set-header! d req-flush 0)
      (set-desc! d 0 (ring-addr d o-hdr) 16 desc-next 1)
      (set-desc! d 1 (ring-addr d o-status) 1 desc-write 0)
      (submit! d))
    :unsupported))

;; ── block-device maps ─────────────────────────────────────────────────────

(defn device-map [id d]
  (let [nm  (str "virtio" id)
        chk (fn [op lba n result] (beer.blk/check nm op lba n result))]
    {:name        nm
     :driver      :virtio-beerlang
     :sector-size sector
     :sectors     (:sectors d)
     :read-only?  (:read-only? d)
     :read!       (fn [lba n buf off] (chk :read lba n (rw! d false lba n buf off)))
     :write!      (fn [lba n buf off] (chk :write lba n (rw! d true lba n buf off)))
     :flush!      (when (:can-flush? d)
                    (fn [] (chk :flush 0 0 (flush-cache! d))))
     :state       d}))

(defn attach!
  "Initialise every virtio-blk device with this driver and register them
  as virtio0, virtio1, ... in slot order (same names as the C driver).
  Takes devices away from whichever driver had them."
  []
  (let [bases (vec (probe))]
    (doseq [i (range (count bases))]
      (beer.blk/register-device! (device-map i (init (nth bases i)))))
    (beer.blk/devices)))

;; ── boot: which driver owns the devices ───────────────────────────────────
;; :beerlang (this file) or :native (kernel/virtio_blk.c).

(def boot-driver :beerlang)

(if (= boot-driver :beerlang)
  (attach!)
  (beer.blk/use-native-driver!))
