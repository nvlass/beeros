;; beeros configuration, read by /etc/init.beer
{:hostname "beerbox"
 :motd     "Welcome to beeros. (beer.fs/ls \"/\") to look around."
 :keyboard {:layout :us}
 ;; On a screen: :wm, windows with REPLs (beer.wm; options :cols :rows
 ;; :scale for new windows), or :term, one full-screen REPL (beer.term;
 ;; :scale :cols :rows :x :y :fg :bg). :wm wins if both are set.
 :console  {:wm {:cols 48 :rows 14 :scale 2}}}
