;; /etc/init.beer — runs at boot, after / is mounted and the libraries
;; are loaded. Edit it on the disk image to change what happens at boot.

(ns beer.init)

(def config (read-string (beer.fs/slurp "/etc/beeros.edn")))

(when (:motd config)
  (println (:motd config)))

;; Patched libraries: (beer.reload/ns! ...) each namespace listed under
;; :reload, so edits to /lib/beer/*.beer (also the built-in ones) persist.
(doseq [n (get config :reload [])]
  (try (beer.reload/ns! n)
       (catch e (println (str "[beeros] reload " n ": " (if (map? e) (:message e) (pr-str e)))))))

;; A terminal REPL on the screen (graphics builds), next to the serial one.
(defn gfx? [] (try (not (empty? (ns-publics 'beer.gfx))) (catch e false)))

;; :console {:wm {...}}: windows (beer.wm); {:term {...}}: one full-screen REPL
(def wm-opts   (get-in config [:console :wm]))
(def term-opts (get-in config [:console :term]))

(when (and wm-opts (gfx?))
  (require 'beer.wm)
  (beer.wm/start! (if (map? wm-opts) wm-opts {})))

(when (and term-opts (not wm-opts) (gfx?))
  (require 'beer.term)
  (def term (beer.term/start-repl! (if (map? term-opts) term-opts {}))))
