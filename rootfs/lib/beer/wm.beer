;; beer.wm — a minimal window manager in the spirit of wm2
;;
;; Overlapping windows, each a REPL on a beer.term; a title tab with a
;; close box; click to raise and focus, drag the tab to move. The window
;; manager owns the keyboard and the pointer: it reads beer.input's queue,
;; moves the pointer, and hands key events to the focused window.
;;
;;   mouse                          keys (for when QEMU grabs the mouse)
;;   click the desktop: new REPL    Ctrl-Alt-Enter  new REPL
;;   click a window: raise, focus   Ctrl-Alt-Tab    next window
;;   drag the tab: move             Ctrl-Alt-W      close
;;                                  F1, Ctrl-Alt-H  help (beer.help)
;;   click the box in the tab: close
;;
;; Every window draws into its own beer.gfx surface; the screen shows a
;; surface where the owner map says so (restack! sets it, back to front),
;; so a window never draws over the one above it.
;;
;;   (beer.wm/start! {:cols 48 :rows 14 :scale 2})
;;   (beer.wm/open! {:x 100 :y 80})
;;   (def c (beer.wm/canvas! {:w 320 :h 200 :scale 2}))   ; a window to draw in
;;   (beer.gfx/fill-rect-on! (:surface c) 10 10 50 50 0xFF0000) (beer.wm/show! c)

(ns beer.wm
  (:require [beer.term] [beer.font]))

(def desktop-color 0x2E3440)
(def border-color  0x000000)
(def tab-focused   0xE5C07B)
(def tab-plain     0x9097A0)
(def tab-text      0x000000)
(def border 1)
(def tab-h 12)              ; title tab: the 8x8 font plus 2 px above and below

(beer.reload/defonce state (atom {:windows [] :focus nil :pointer [0 0] :drag nil :next 1
                  :opts {} :task nil}))

(def font (beer.font/builtin))

;; ── drawing a window's frame ──────────────────────────────────────────────

(defn text-on! [s x y text color]
  (let [n (count text)]
    (loop [i 0 x x]
      (when (< i n)
        (beer.font/draw-glyph-on! s font x y (beer.font/glyph font (int (nth text i))) color nil 1)
        (recur (inc i) (+ x 8))))))

(defn close-box [w]                   ; [x y size] in window coordinates
  [(- (:w w) border tab-h) border tab-h])

(defn draw-frame! [w focused?]
  (when (not= false (:frame? w))
  (let [s (:surf w) ww (:w w) wh (:h w)
        [bx by bs] (close-box w)]
    (beer.gfx/fill-rect-on! s 0 0 ww border border-color)
    (beer.gfx/fill-rect-on! s 0 (- wh border) ww border border-color)
    (beer.gfx/fill-rect-on! s 0 0 border wh border-color)
    (beer.gfx/fill-rect-on! s (- ww border) 0 border wh border-color)
    (beer.gfx/fill-rect-on! s border border (- ww (* 2 border)) tab-h (if focused? tab-focused tab-plain))
    (beer.gfx/fill-rect-on! s border (+ border tab-h) (- ww (* 2 border)) border border-color)
    (text-on! s (+ border 4) (+ border 2) (:title w) tab-text)
    ;; close box: a framed square with an x
    (beer.gfx/fill-rect-on! s (+ bx 2) (+ by 2) (- bs 4) (- bs 4) tab-text)
    (beer.gfx/fill-rect-on! s (+ bx 3) (+ by 3) (- bs 6) (- bs 6) (if focused? tab-focused tab-plain))
    (loop [i 0]
      (when (< i (- bs 8))
        (beer.gfx/fill-rect-on! s (+ bx 4 i) (+ by 4 i) 1 1 tab-text)
        (beer.gfx/fill-rect-on! s (- (+ bx bs) 5 i) (+ by 4 i) 1 1 tab-text)
        (recur (inc i)))))))

;; ── compositing ───────────────────────────────────────────────────────────

(defn window [id] (some (fn [w] (when (= (:id w) id) w)) (:windows @state)))

(defn present! [w] (beer.gfx/present! (:surf w) 0 0 (:w w) (:h w) (:x w) (:y w)))

(defn restack!
  "Owner map back to front, then repaint the desktop and every window."
  []
  (let [ws (:windows @state)]
    (beer.gfx/own! 0 0 0 (beer.gfx/width) (beer.gfx/height))
    (doseq [w ws] (beer.gfx/own! (:surf w) (:x w) (:y w) (:w w) (:h w)))
    (beer.gfx/fill-owned! 0 0 0 (beer.gfx/width) (beer.gfx/height) desktop-color)
    (doseq [w ws] (present! w))
    nil))

;; ── windows ───────────────────────────────────────────────────────────────

(defn focused [] (window (:focus @state)))

(defn focus!
  "Raise window id to the top and give it the keyboard."
  [id]
  (let [old (focused)
        w   (window id)]
    (when w
      (swap! state (fn [st] (assoc st :focus id
                                   :windows (conj (vec (filter (fn [x] (not= (:id x) id)) (:windows st)))
                                                  w))))
      (when (and old (not= (:id old) id)) (draw-frame! old false))
      (draw-frame! w true)
      (restack!))
    nil))

(defn open!
  "A new window running a REPL, or (:run opts), a fn of no arguments,
  with the window's terminal as its console (the window closes when it
  returns). Options as for start! plus :x :y :title :run."
  ([] (open! {}))
  ([opts]
   (let [o     (merge (:opts @state) opts)
         scale (get o :scale 2)
         cols  (get o :cols 48)
         rows  (get o :rows 14)
         cw    (* scale (:width font)) ch (* scale (:height font))
         w     (+ (* 2 border) (* cols cw))
         h     (+ border tab-h border (* rows ch) border)
         n     (:next @state)
         x     (max 0 (min (get o :x (+ 40 (* 24 (rem n 10)))) (- (beer.gfx/width) w)))
         y     (max 0 (min (get o :y (+ 40 (* 24 (rem n 10)))) (- (beer.gfx/height) h)))
         s     (beer.gfx/surface w h)]
     (when (nil? s) (throw (ex-info "wm: no free surface" {:reason :no-surface})))
     (let [id   n
           keys (chan 64)
           t    (beer.term/make {:surface s :x border :y (+ border tab-h border)
                                 :cols cols :rows rows :scale scale :keys keys
                                 :present (fn [] (let [w (window id)] (when w (present! w))))})
           win  {:id id :surf s :x x :y y :w w :h h :title (get o :title (str "repl " n))
                 :term t :keys keys}]
       (swap! state (fn [st] (assoc st :next (inc n) :windows (conj (:windows st) win))))
       (beer.term/start! t)
       (let [run (:run o)
             r (spawn (fn []
                        (if run
                          (do (try (beer.term/with-term t run)
                                   (catch e nil))
                              (close! id))
                          (beer.term/repl t))))]
         (swap! (:in @t) (fn [m] (assoc m :repl r))))
       (focus! id)
       id))))

(defn close!
  "Close window id (default: the focused one): stop its REPL, free its surface."
  ([] (let [w (focused)] (when w (close! (:id w)))))
  ([id]
   (let [w (window id)]
     (when w
       (if (:term w)
         (beer.term/close! (:term w))
         (offer! (:keys w) {:type :close}))
       (swap! state (fn [st] (assoc st :windows (vec (filter (fn [x] (not= (:id x) id)) (:windows st)))
                                    :focus (when (not= (:focus st) id) (:focus st)))))
       (beer.gfx/surface-free! (:surf w))
       (let [top (last (:windows @state))]
         (if (and top (nil? (:focus @state)))
           (focus! (:id top))
           (restack!))))
     nil)))

(defn next-window! []
  (let [ws (:windows @state)]
    (when (> (count ws) 1) (focus! (:id (first ws))))))

(defn move! [id x y]
  (swap! state (fn [st] (assoc st :windows (vec (map (fn [w] (if (= (:id w) id) (assoc w :x x :y y) w))
                                                    (:windows st))))))
  nil)

;; ── canvases: windows you draw in ───────────────────────────────────────

(defn canvas-of [w] (:canvas w))

(defn canvas-point
  "Pointer position in canvas w's coordinates, or nil if outside it."
  [w]
  (let [[px py] (:pointer @state)
        c (:canvas w)
        [ox oy] (:content w)
        x (quot (- px (:x w) ox) (:scale c))
        y (quot (- py (:y w) oy) (:scale c))]
    (when (and (>= (- px (:x w) ox) 0) (>= (- py (:y w) oy) 0) (< x (:w c)) (< y (:h c)))
      [x y])))

(defn canvas-under-pointer? [w]
  (let [[px py] (:pointer @state)] (and (= w (window-at px py)) (canvas-point w))))

(defn canvas-event! [w ev]
  (let [p (canvas-point w)]
    (when p (offer! (:keys w) (assoc ev :x (first p) :y (second p))))))

(defn pointer-moved! []
  (let [w (focused)]
    (when (and w (:canvas w) (not (:drag @state)) (canvas-under-pointer? w))
      (canvas-event! w {:type :pointer}))))

(defn show!
  "Show what was drawn on canvas c's surface (scaled), now."
  [c]
  (let [w (window (:id c))]
    (when w
      (let [[ox oy] (:content w) sc (:scale c)
            cw (* sc (:w c)) ch (* sc (:h c))]
        (beer.gfx/blit-surface! (:surface c) 0 0 (:w c) (:h c) (:surf w) ox oy sc)
        (beer.gfx/present! (:surf w) ox oy cw ch (+ (:x w) ox) (+ (:y w) oy))))
    nil))

(defn close-canvas!
  "Close canvas c (its window, if the WM hasn't already) and free its surface."
  [c]
  (when (window (:id c)) (close! (:id c)))
  (beer.gfx/surface-free! (:surface c))
  nil)

(defn canvas!
  "A window you draw in. Returns {:id :surface :w :h :scale :events}: draw
  on :surface (a beer.gfx surface, w x h; fill-rect-on!, blit-pixels!,
  ...) and (show! c) to put it on screen, each pixel scale x scale.
  :events is a channel of the window's input while it has the focus: key
  events (down and up, as from beer.input), {:type :button :button :down?
  :x :y}, {:type :pointer :x :y}, {:type :wheel :delta :x :y}, and
  {:type :close} when the WM closes it (then call close-canvas!).
  Ctrl-\\ interrupts the task that made it. Options: :w :h (320x200)
  :scale (2) :title :x :y, :fullscreen true (no frame, the whole screen,
  scale chosen to fit)."
  ([] (canvas! {}))
  ([opts]
   (let [cw (get opts :w 320) ch (get opts :h 200)
         full? (:fullscreen opts)
         sw (beer.gfx/width) sh (beer.gfx/height)
         scale (if full? (max 1 (min (quot sw cw) (quot sh ch))) (get opts :scale 2))
         [w h ox oy] (if full?
                       [sw sh (quot (- sw (* scale cw)) 2) (quot (- sh (* scale ch)) 2)]
                       [(+ (* 2 border) (* scale cw)) (+ border tab-h border (* scale ch) border)
                        border (+ border tab-h border)])
         n (:next @state)
         x (if full? 0 (max 0 (min (get opts :x (+ 40 (* 24 (rem n 10)))) (- sw w))))
         y (if full? 0 (max 0 (min (get opts :y (+ 40 (* 24 (rem n 10)))) (- sh h))))
         ws (beer.gfx/surface w h)
         us (beer.gfx/surface cw ch)]
     (when (or (nil? ws) (nil? us)) (throw (ex-info "wm: no free surface" {:reason :no-surface})))
     (let [events (chan 256)
           c {:id n :surface us :w cw :h ch :scale scale :events events}
           win {:id n :surf ws :x x :y y :w w :h h :title (get opts :title (str "canvas " n))
                :keys events :canvas c :content [ox oy] :frame? (not full?)
                :owner (current-task)}]
       (swap! state (fn [st] (assoc st :next (inc n) :windows (conj (:windows st) win))))
       (focus! n)
       c))))

;; ── input ─────────────────────────────────────────────────────────────────

(defn window-at
  "The topmost window under (x,y), or nil."
  [x y]
  (last (filter (fn [w] (and (>= x (:x w)) (< x (+ (:x w) (:w w)))
                             (>= y (:y w)) (< y (+ (:y w) (:h w)))))
                (:windows @state))))

(defn pointer! [x y]
  (let [x (max 0 (min x (dec (beer.gfx/width))))
        y (max 0 (min y (dec (beer.gfx/height))))]
    (swap! state (fn [st] (assoc st :pointer [x y])))
    (beer.gfx/cursor! x y true)))

(defn on-press! []
  (let [[px py] (:pointer @state)
        w (window-at px py)]
    (if (nil? w)
      (open! {:x px :y py})
      (let [lx (- px (:x w)) ly (- py (:y w))
            [bx by bs] (close-box w)
            framed? (not= false (:frame? w))]
        (cond
          (and framed? (>= lx bx) (< lx (+ bx bs)) (>= ly by) (< ly (+ by bs))) (close! (:id w))
          (and framed? (< ly (+ border tab-h))) (do (focus! (:id w))
                                                    (swap! state (fn [st] (assoc st :drag [(:id w) lx ly]))))
          (not= (:focus @state) (:id w)) (focus! (:id w))
          (:canvas w) (canvas-event! w {:type :button :button :left :down? true})
          :else nil)))))

(defn drag-to! []
  (let [st @state [id ox oy] (:drag st) [px py] (:pointer st)]
    (when id
      (move! id (- px ox) (- py oy))
      (restack!))))

(defn help!
  "Raise the help window, opening it (beer.help/browse) if there is none."
  []
  (let [w (some (fn [w] (when (:help? w) w)) (:windows @state))]
    (if w
      (focus! (:id w))
      (do (require 'beer.help)
          (let [id (open! {:title "help" :cols 72 :rows 30 :x 400 :y 60
                           :run (fn [] ((eval 'beer.help/browse)))})]
            (swap! state (fn [st] (assoc st :windows (vec (map (fn [w] (if (= (:id w) id) (assoc w :help? true) w))
                                                              (:windows st)))))))))
    nil))

(defn wm-key?
  "F1, Ctrl-Alt-Enter/Tab/W/H; true if it was one (and it's done)."
  [ev]
  (let [m (or (:mods ev) #{}) k (:key ev)]
    (when (:down? ev)
      (cond (and (= k :f1) (empty? m)) (do (help!) true)
            (and (contains? m :ctrl) (contains? m :alt))
            (cond (= k :enter) (do (open!) true)
                  (= k :tab)   (do (next-window!) true)
                  (= k :w)     (do (close!) true)
                  (= k :h)     (do (help!) true)
                  :else false)
            :else false))))

(defn handle! [ev]
  (let [t (:type ev)]
    (cond
      (= t :key)    (when (not (wm-key? ev))
                      (let [w (focused)] (when w (offer! (:keys w) ev))))
      (= t :motion) (let [[x y] (:pointer @state)]
                      (pointer! (+ x (:dx ev)) (+ y (:dy ev)))
                      (pointer-moved!))
      (= t :abs)    (do (pointer! (int (* (:x ev) (beer.gfx/width))) (int (* (:y ev) (beer.gfx/height))))
                        (pointer-moved!))
      (= t :button) (cond
                      (and (= (:button ev) :left) (:down? ev)) (on-press!)
                      (and (= (:button ev) :left) (:drag @state))
                      (do (drag-to!) (swap! state (fn [st] (assoc st :drag nil))))
                      :else (let [w (focused)]
                              (when (and w (:canvas w) (canvas-under-pointer? w))
                                (canvas-event! w {:type :button :button (:button ev) :down? (:down? ev)}))))
      (= t :wheel)  (let [w (focused)]
                      (when (and w (:canvas w)) (canvas-event! w {:type :wheel :delta (:delta ev)})))
      :else nil)))

(defn run-loop []
  (loop []
    (handle! (<! beer.input/queue))
    ;; take what else is waiting before repainting a drag
    (loop [] (let [ev (poll! beer.input/queue)] (when ev (handle! ev) (recur))))
    (when (:drag @state) (drag-to!))
    (recur)))

(defn start!
  "Take over the screen, the keyboard and the pointer; open one REPL.
  Options (defaults for new windows): :cols :rows :scale."
  ([] (start! {}))
  ([opts]
   (when (nil? (:task @state))
     (swap! state (fn [st] (assoc st :opts opts)))
     (reset! beer.tty/use-keyboard? false)
     (reset! beer.tty/keyboard-interrupt
             (fn [kind] (let [w (focused)]
                          (cond (nil? w) nil
                                (:term w) (beer.term/interrupt-key! (:term w) kind)
                                (and (= kind :hard) (:owner w)) (do (interrupt! (:owner w)) true)
                                :else nil))))
     (restack!)
     (pointer! (quot (beer.gfx/width) 2) (quot (beer.gfx/height) 2))
     (open! {})
     (swap! state (fn [st] (assoc st :task (spawn run-loop)))))
   nil))
